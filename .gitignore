# local environments / caches
.venv/
__pycache__/
.pytest_cache/
node_modules/

# fetched + exported data (reproducible via fetch.py + export.py;
# provenance lives in data/MANIFEST.toml, which IS committed).
# No trailing slash: in agent worktrees these are symlinks to the primary
# checkout's dirs, and a dir-only pattern would not match them.
data/raw
web/data
