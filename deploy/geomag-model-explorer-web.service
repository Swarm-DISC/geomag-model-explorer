# geomag-model-explorer — geomagnetic field globe: EXAMPLE systemd --user unit.
#
# This example assumes a checkout at %h/geomag-model-explorer (%h = the user's home).
# Paths use the %h specifier, so it works for any user with that layout. A host with a
# different layout (another checkout path, a different bind address or port, extra
# environment) should override those settings with a drop-in rather than editing this file:
#   systemctl --user edit geomag-model-explorer-web.service
# (a drop-in that changes ExecStart must first clear it with an empty `ExecStart=` line).
#
# Serves the static frontend + tiles + day-fetch API on 127.0.0.1:8212. Put a reverse proxy
# in front of it to serve it under a path prefix (the frontend uses only relative URLs). The
# UI is read-only to anonymous visitors; the one mutating route (POST /api/days, which runs
# VirES fetch/export subprocesses) is token-gated in-app and fails closed without a token.
# If you bind other interfaces, front it with an authenticating proxy first.
#
# Environment (set in a drop-in with `Environment=` or `EnvironmentFile=`):
#   GEOMAG_MODEL_EXPLORER_DATA  relocates the data/cache tree (default: the checkout).
#   GEOMAG_API_TOKEN            shared secret for POST /api/days (sent as X-API-Token or
#                               Authorization: Bearer), or
#   GEOMAG_API_TOKEN_FILE       path of a file holding that secret (used when
#                               GEOMAG_API_TOKEN is unset or empty).
#   With neither set, on-demand day fetches are disabled (every POST is rejected).
#   Day fetches also need VirES credentials in the service user's ~/.viresclient.ini.
#
# Install (one-time; link the unit from the checkout rather than copying it):
#   systemctl --user link <checkout>/deploy/geomag-model-explorer-web.service
#   systemctl --user daemon-reload
#   systemctl --user enable --now geomag-model-explorer-web.service
#   loginctl enable-linger "$USER"     # keep it running without a login session
# Status / logs / restart:
#   systemctl --user status geomag-model-explorer-web.service
#   journalctl --user -u geomag-model-explorer-web.service -f
#   systemctl --user restart geomag-model-explorer-web.service

[Unit]
Description=geomag-model-explorer — geomagnetic field globe (http on :8212)

[Service]
Type=simple
WorkingDirectory=%h/geomag-model-explorer
# systemd user units do NOT inherit the login shell's PATH; uv lives in
# ~/.local/bin. `--extra fetch` keeps the venv stable across the service and
# the day-fetch subprocesses (which need viresclient) — plain `uv run` would
# flip the venv between synced states on every job.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStartPre=%h/.local/bin/uv sync --frozen --inexact --extra fetch
ExecStart=%h/geomag-model-explorer/.venv/bin/uvicorn serve:app --host 127.0.0.1 --port 8212
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
